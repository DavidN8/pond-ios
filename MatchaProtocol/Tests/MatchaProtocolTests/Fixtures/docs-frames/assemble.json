{
    "op": "docs.assemble",
    "description": "Reassembles the updates the frames among events (oldest first) complete, like RoomDocumentSession: events are taken once by event id (events without one are skipped), updates once by sender and update id. updates lists the complete updates in the order they complete (base64). missing lists committed updates still missing parts (the document is then incomplete and read-only); pending lists parts without a commit yet. error invalid_update or decrypt_error stops the document.",
    "cases": [
        {
            "name": "a single update frame",
            "input": {
                "events": [
                    {
                        "type": "com.matchahoneylatte.docs.update",
                        "event_id": "$e149:example.org",
                        "sender": "@bob:example.org",
                        "origin_server_ts": 1767225600000,
                        "content": {
                            "version": 1,
                            "doc": "main",
                            "update_id": "u-1",
                            "kind": "update",
                            "chunks": 1,
                            "chunk": 0,
                            "data": "AQID",
                            "m.relates_to": {
                                "rel_type": "m.reference",
                                "event_id": "$create:example.org"
                            }
                        }
                    }
                ],
                "anchor": "$create:example.org",
                "documentId": "main"
            },
            "expect": {
                "updates": [
                    "AQID"
                ],
                "missing": [],
                "pending": []
            }
        },
