{
    "op": "reminders.is_valid",
    "description": "When a reminder fires (dueAt) and whether the bot accepts it: in the future, at most 365 days after now, a delay of 1 to 999999999 units, a message of 1 to 2000 UTF-16 code units after trimming.",
    "cases": [
        {
            "name": "one second",
            "input": {
                "time": {
                    "in": 1,
                    "unit": "seconds"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767225601000,
                "isValid": true
            }
        },
        {
            "name": "exactly 365 days",
            "input": {
                "time": {
                    "in": 365,
                    "unit": "days"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798761600000,
                "isValid": true
            }
        },
        {
            "name": "366 days is too far",
            "input": {
                "time": {
                    "in": 366,
                    "unit": "days"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798848000000,
                "isValid": false
            }
        },
        {
            "name": "8760 hours is exactly a year",
            "input": {
                "time": {
                    "in": 8760,
                    "unit": "hours"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798761600000,
                "isValid": true
            }
        },
        {
            "name": "8761 hours is too far",
            "input": {
                "time": {
                    "in": 8761,
                    "unit": "hours"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798765200000,
                "isValid": false
            }
        },
        {
            "name": "a zero delay",
            "input": {
                "time": {
                    "in": 0,
                    "unit": "minutes"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767225600000,
                "isValid": false
            }
        },
        {
            "name": "a negative delay",
            "input": {
                "time": {
                    "in": -1,
                    "unit": "hours"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767222000000,
                "isValid": false
            }
        },
        {
            "name": "the largest delay amount, still too far",
            "input": {
                "time": {
                    "in": 999999999,
                    "unit": "seconds"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 2767225599000,
                "isValid": false
            }
        },
        {
            "name": "a delay amount over the bound",
            "input": {
                "time": {
                    "in": 1000000000,
                    "unit": "seconds"
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 2767225600000,
                "isValid": false
            }
        },
        {
            "name": "an exact time of now",
            "input": {
                "time": {
                    "at": 1767225600000
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767225600000,
                "isValid": false
            }
        },
        {
            "name": "an exact time in the past",
            "input": {
                "time": {
                    "at": 1767225599999
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767225599999,
                "isValid": false
            }
        },
        {
            "name": "an exact time 1 ms ahead",
            "input": {
                "time": {
                    "at": 1767225600001
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767225600001,
                "isValid": true
            }
        },
        {
            "name": "an exact time 365 days ahead",
            "input": {
                "time": {
                    "at": 1798761600000
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798761600000,
                "isValid": true
            }
        },
        {
            "name": "an exact time 1 ms past 365 days",
            "input": {
                "time": {
                    "at": 1798761600001
                },
                "message": "x",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1798761600001,
                "isValid": false
            }
        },
        {
            "name": "a blank message",
            "input": {
                "time": {
                    "in": 1,
                    "unit": "hours"
                },
                "message": "   ",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767229200000,
                "isValid": false
            }
        },
        {
            "name": "a message of 2000 characters",
            "input": {
                "time": {
                    "in": 1,
                    "unit": "hours"
                },
                "message": "",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767229200000,
                "isValid": true
            }
        },
        {
            "name": "a message of 2001 characters",
            "input": {
                "time": {
                    "in": 1,
                    "unit": "hours"
                },
                "message": "",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767229200000,
                "isValid": false
            }
        },
        {
            "name": "the message is measured after trimming",
            "input": {
                "time": {
                    "in": 1,
                    "unit": "hours"
                },
                "message": "    ",
                "now": 1767225600000
            },
            "expect": {
                "dueAt": 1767229200000,
                "isValid": true
            }
        }
    ]
}
