{
    "op": "tasks.local_deadline",
    "description": "Turns a picked local date and time (ISO yyyy-MM-ddTHH:mm) in an IANA time zone into a card deadline: valid with epochMillis, skipped when a clock change skips that time, out_of_range outside 1..253402300799999. A repeated time takes the earlier offset.",
    "cases": [
        {
            "name": "a time in a zone without daylight saving",
            "input": {
                "dateTime": "2026-01-15T09:00",
                "timeZone": "Asia/Jakarta"
            },
            "expect": {
                "result": "valid",
                "epochMillis": 1768442400000
            }
        },
        {
            "name": "a time skipped by the spring change in New York",
            "input": {
                "dateTime": "2026-03-08T02:30",
                "timeZone": "America/New_York"
            },
            "expect": {
                "result": "skipped"
            }
        },
        {
            "name": "the first skipped minute",
            "input": {
                "dateTime": "2026-03-08T02:00",
                "timeZone": "America/New_York"
            },
            "expect": {
                "result": "skipped"
            }
        },
        {
            "name": "the first time after the change",
            "input": {
                "dateTime": "2026-03-08T03:00",
                "timeZone": "America/New_York"
            },
            "expect": {
                "result": "valid",
                "epochMillis": 1772953200000
            }
        },
        {
            "name": "a time repeated by the autumn change takes the earlier offset",
            "input": {
                "dateTime": "2026-11-01T01:30",
                "timeZone": "America/New_York"
            },
            "expect": {
                "result": "valid",
                "epochMillis": 1793511000000
            }
        },
        {
            "name": "a time skipped in Berlin",
            "input": {
                "dateTime": "2026-03-29T02:30",
                "timeZone": "Europe/Berlin"
            },
            "expect": {
                "result": "skipped"
            }
        },
        {
            "name": "a half-hour change on Lord Howe Island",
            "input": {
                "dateTime": "2026-10-04T02:15",
                "timeZone": "Australia/Lord_Howe"
            },
            "expect": {
                "result": "skipped"
            }
        },
        {
            "name": "the epoch itself is out of range",
            "input": {
                "dateTime": "1970-01-01T00:00",
                "timeZone": "UTC"
            },
            "expect": {
                "result": "out_of_range"
            }
        },
        {
            "name": "before the epoch is out of range",
            "input": {
                "dateTime": "1969-12-31T23:59",
                "timeZone": "UTC"
            },
            "expect": {
                "result": "out_of_range"
            }
        },
        {
            "name": "the epoch in a zone ahead of UTC is out of range",
            "input": {
                "dateTime": "1970-01-01T00:00",
                "timeZone": "Asia/Jakarta"
            },
            "expect": {
                "result": "out_of_range"
            }
        },
        {
            "name": "the last minute of 9999 in UTC is valid",
            "input": {
                "dateTime": "9999-12-31T23:59",
                "timeZone": "UTC"
            },
            "expect": {
                "result": "valid",
                "epochMillis": 253402300740000
            }
        },
        {
            "name": "the last minute of 9999 in New York is after the range",
            "input": {
                "dateTime": "9999-12-31T23:59",
                "timeZone": "America/New_York"
            },
            "expect": {
                "result": "out_of_range"
            }
        }
    ]
}
